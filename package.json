{
  "name": "creditpulse",
  "version": "0.1.0",
  "description": "Open-source Chrome extension to track credit card transactions, offers, milestones, and due dates for Indian credit cards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["chrome-extension", "credit-card", "india", "finance", "offers"],
  "author": "Lakshay Middha <Lakshaymiddha@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "node-html-parser": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "^0.2.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
